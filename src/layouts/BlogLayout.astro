---
export interface Props {
  title: string;
  description?: string;
  fonts?: string[];
}

const { title, description, fonts = [] } = Astro.props;

import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/content.css';
import '../styles/layout.css';
import '../styles/player.css';
import '../styles/tooltip.css';
import '../styles/blockquote.css';

import TopBar from '../components/TopBar.astro';
import NavBar from '../components/NavBar.astro';

const fontBase = '/blog/fonts/iosevka';
const fontPreloads = [
  `${fontBase}/core/slab/core-slab-regular.woff2`,
  `${fontBase}/core/slab/core-slab-bold.woff2`,
  ...(fonts.includes('cr') ? [
    `${fontBase}/cr/slab/cr-slab-regular.woff2`,
    `${fontBase}/cr/slab/cr-slab-bold.woff2`,
  ] : []),
  ...(fonts.includes('gr') ? [
    `${fontBase}/gr/slab/gr-slab-regular.woff2`,
  ] : []),
  ...(fonts.includes('ipa') ? [
    `${fontBase}/ipa/slab/ipa-slab-regular.woff2`,
  ] : []),
  ...(fonts.includes('code') ? [
    `${fontBase}/code/slab/code-slab-regular.woff2`,
    `${fontBase}/code/term/code-term-regular.woff2`,
  ] : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description ?? 'Blog'} />
    <link rel="icon" type="image/svg+xml" href="/blog/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Taylor Towers RSS" href="/blog/rss.xml" />
    <link rel="preload" as="audio" type="audio/opus" href="/blog/media/audio/purple-hint.opus" />
    {fontPreloads.map((href) => (
      <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
    ))}
  </head>
  <body>

    <NavBar />

    <div class="content-box">
      <TopBar />
      <main>
        <slot />
      </main>
    </div>

    <script is:inline src="/blog/scripts/copy-code.js"></script>
    <script is:inline src="/blog/scripts/tooltip.js"></script>
    <script is:inline src="/blog/scripts/audio-player.js"></script>
    <script is:inline src="/blog/scripts/quote-dropdown.js"></script>
    <script is:inline>
      document.querySelectorAll('.post-content a')
        .forEach(a => a.target = '_blank');
    </script>
    <script is:inline src="/blog/scripts/heading-anchor.js"></script>
  </body>
</html>
