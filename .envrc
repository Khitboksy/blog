use flake

# Background dev server, managed by scripts/devctl.
# Starts on env load; a watchdog stops it when this direnv env unloads
# (shell leaves the repo, or the shell exits). See: devctl {status,logs,kill}
# Note: DIRENV_DIR/FILE are empty during eval — PWD is the .envrc's dir.
ENVRC_DIR="$PWD"
watch_file "$ENVRC_DIR/scripts/devctl"
PATH_add "$ENVRC_DIR/scripts"
devctl start --shell "$(awk '/^PPid:/{print $2}' "/proc/$PPID/status" 2>/dev/null)" || true
